{
  "name": "print-salesorder",
  "version": "0.1.0",
  "description": "PrintFlow - Sales Order Service for print production (SAP CAP)",
  "repository": "https://github.com/Pollmoriy/print_salesorder.git",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "watch": "cds watch",
    "build": "cds build --production",
    "start": "cds run",
    "watch-orders": "cds watch --open printflow.orders/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-customers": "cds watch --open printflow.customers/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-products": "cds watch --open printflow.products/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-materials": "cds watch --open printflow.materials/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-warehouses": "cds watch --open printflow.warehouses/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-productionorders": "cds watch --open printflow.productionorders/index.html?sap-ui-xx-viewCache=false --livereload false"
  },
  "devDependencies": {
    "@cap-js/cds-types": "^0.18.0",
    "@cap-js/sqlite": "^3",
    "@sap/cds-dk": "^10",
    "@types/node": "^24.0.0",
    "tsx": "^4",
    "typescript": "^7.0.0",
    "@cap-js/cds-typer": ">=0.1",
    "cds-plugin-ui5": "^0.17.0"
  },
  "imports": {
    "#cds-models/*": "./@cds-models/*/index.js"
  },
  "dependencies": {
    "@sap/cds": "^10",
    "@cap-js/hana": "^3",
    "express": "^4",
    "@sap/xssec": "^4"
  },
  "cds": {
    "requires": {
      "db": {
        "[production]": {
          "kind": "hana"
        },
        "[development]": {
          "kind": "sqlite",
          "credentials": {
            "url": "db/data.sqlite"
          }
        }
      },
      "[production]": {
        "auth": "xsuaa"
      },
      "[development]": {
        "auth": {
          "kind": "mocked",
          "users": {
            "alice": {
              "password": "alice",
              "roles": [
                "authenticated-user"
              ]
            }
          }
        }
      }
    }
  },
  "sapux": [
    "app/orders",
    "app/customers",
    "app/products",
    "app/materials",
    "app/warehouses",
    "app/productionorders",
    "app/productionorders"
  ],
  "workspaces": [
    "app/*"
  ]
}

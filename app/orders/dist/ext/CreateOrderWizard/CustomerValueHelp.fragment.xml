<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
  <SelectDialog
    title="{i18n>selectCustomer}"
    items="{path: '/Customers', sorter: { path: 'name' }}"
    search="onCustomerSearch"
    confirm="onCustomerSelected">
    <StandardListItem
      title="{name}"
      description="{company}"
      info="{email}"/>
  </SelectDialog>
</core:FragmentDefinition>
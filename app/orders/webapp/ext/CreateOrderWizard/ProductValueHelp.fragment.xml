<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
  <SelectDialog
    title="{i18n>selectProduct}"
    items="{path: '/Products', sorter: { path: 'name' }}"
    search="onProductSearch"
    confirm="onProductSelected">
    <StandardListItem
      title="{name}"
      description="{code}"
      info="{basePrice}"/>
  </SelectDialog>
</core:FragmentDefinition>
<mvc:View
  controllerName="printflow.dashboard.controller.App"
  xmlns="sap.m"
  xmlns:mvc="sap.ui.core.mvc"
  displayBlock="true">
  <App>
    <Page title="{i18n>pageTitle}" showHeader="true" class="sapUiContentPadding">
      <content>
        <VBox>
          <Title text="{greeting>/text}" level="H2" class="dashGreetingTitle"/>
          <Text text="Here's your PrintFlow overview." class="dashGreetingSubtitle"/>

          <HBox id="kpiContainer" class="dashKpiRow sapUiMediumMarginTop" wrap="Wrap"/>

          <HBox class="dashColumns sapUiMediumMarginTop" wrap="Wrap">
            <VBox id="ordersChartContainer" class="dashPanel"/>
            <VBox id="productionChartContainer" class="dashPanel"/>
          </HBox>

          <HBox class="dashColumns sapUiMediumMarginTop" wrap="Wrap">
            <VBox id="attentionContainer" class="dashPanel"/>
            <VBox id="recentOrdersContainer" class="dashPanel"/>
          </HBox>
        </VBox>
      </content>
    </Page>
  </App>
</mvc:View>